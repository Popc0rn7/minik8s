# Copy this file to .env and edit values for your local environment.
# Shell environment variables take precedence over values in this file.

# Harbor API used by apply/get/describe/delete and related CLI commands.
MINIK8S_HARBOR=http://127.0.0.1:18080

# Uncomment to force etcd-backed Logbook instead of local JSON file store.
# MINIK8S_LOGBOOK_ENDPOINTS=http://127.0.0.1:2379

# Uncomment when testing serverless NATS event triggers.
# MINIK8S_NATS_URL=nats://127.0.0.1:4222

# Uncomment to keep local JSON state under a custom directory.
# MINIK8S_STATE_DIR=.minik8s/state

# Uncomment for demos without CNI permissions.
# MINIK8S_CNI_DISABLED=1

# Uncomment to customize generated CNI config and plugin directories.
# MINIK8S_CNI_CONF_DIR=.minik8s/cni/net.d
# MINIK8S_CNI_BIN_DIR=.minik8s/cni/bin

# Uncomment to use a custom sandbox pause image for Docker runtime.
# MINIK8S_PAUSE_IMAGE=registry.k8s.io/pause:3.9
